# --- 模式选择 ---
# 配了 DATABASE_URL  → 服务端模式（Postgres + pgvector，见 docker-compose.yml）
# 不配 DATABASE_URL  → 本地模式（SQLite，零依赖）
#   本地模式的库文件路径（默认 ./data/memobox.db）；":memory:" 供测试
# MEMOBOX_DB_PATH=data/memobox.db
# MEMOBOX_BACKEND=stub

# Postgres 连接串（与 docker-compose.yml 一致；pgvector 镜像）
DATABASE_URL=postgres://memobox:memobox@localhost:5433/memobox

# 管理后台口令（单管理员模式，决策记录见 CLAUDE.md）
ADMIN_PASSWORD=change-me

# 向量维度——由第一次生成的迁移锁死。
# 1536 = OpenAI text-embedding-3-small（默认）；1024 = bge-m3。详见 CLAUDE.md。
# EMBEDDING_DIM=1536

# --- Embedding provider（可选；不配 = 关键词检索） ---
# 任何 OpenAI 兼容的 /embeddings 端点都行：
#   OpenAI:      https://api.openai.com/v1        + text-embedding-3-small
#   SiliconFlow: https://api.siliconflow.cn/v1    + BAAI/bge-m3（需全新库 + EMBEDDING_DIM=1024）
#   Ollama 本机:  http://host.docker.internal:11434/v1
# EMBEDDING_API_BASE=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
