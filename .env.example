# --- Mode selection ---
# DATABASE_URL set  → server mode (Postgres + pgvector, see docker-compose.yml)
# DATABASE_URL unset → local mode (SQLite, zero dependencies)
#   Local DB file (default ./data/memobox.db); ":memory:" for tests.
# MEMOBOX_DB_PATH=data/memobox.db
# MEMOBOX_BACKEND=stub

# Postgres (matches docker-compose.yml; pgvector image)
DATABASE_URL=postgres://memobox:memobox@localhost:5433/memobox

# Admin console password for /login (single-admin mode; see decision log)
ADMIN_PASSWORD=change-me

# Embedding dimensions — locked in by the FIRST generated migration.
# 1536 = OpenAI text-embedding-3-small (default); 1024 = bge-m3. See CLAUDE.md.
# EMBEDDING_DIM=1536

# --- Embedding provider (optional; unset = keyword retrieval) ---
# Any OpenAI-compatible /embeddings endpoint works:
#   OpenAI:      https://api.openai.com/v1        + text-embedding-3-small
#   SiliconFlow: https://api.siliconflow.cn/v1    + BAAI/bge-m3 (fresh DB + EMBEDDING_DIM=1024)
# EMBEDDING_API_BASE=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
